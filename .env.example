# Copy this file to ".env" in the same folder and fill in your own keys.
# ".env" is ignored by git. Never commit it or share it.

# Keys for the optional agent. With neither set, the agent reports itself as unavailable.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: change these if a provider renames or retires a model.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
